{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-std=c11",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/main"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Kompiliert die aktuell geöffnete C-Datei mit GCC."
    },
    {
      "label": "run",
      "type": "shell",
      "command": "${workspaceFolder}/main",
      "dependsOn": "build",
      "problemMatcher": [],
      "detail": "Führt das kompilierte C-Programm aus."
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "rm -f ${workspaceFolder}/main",
      "problemMatcher": [],
      "detail": "Löscht die kompilierte Programmdatei."
    }
  ]
}